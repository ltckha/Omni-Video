# Copy file này thành .env (hoặc thêm các dòng export vào ~/.zshrc) rồi điền giá trị thật.
# File .env đã được thêm vào .gitignore, sẽ KHÔNG bị commit lên Git.

# API key Gemini (lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# API key Gemini riêng của Omni (sinh kịch bản). Trống thì dùng GEMINI_API_KEY.
GEMINI_OMNI_API_KEY=

