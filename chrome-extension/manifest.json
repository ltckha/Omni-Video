{
  "manifest_version": 3,
  "name": "Omni Video - Tạo video hàng tiệm",
  "version": "2.0.4",
  "description": "Tạo video hàng tiệm Hiệu giày Hải Nancy trên Google Flow: dán ảnh + kịch bản, tự tải video đúng tên.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://flow.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Omni · Tạo video hàng tiệm"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "flow_page.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
