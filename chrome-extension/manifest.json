{
  "manifest_version": 3,
  "name": "Omni Video - Shopee Image Curator",
  "version": "1.0.0",
  "description": "Lựa chọn ảnh sản phẩm Shopee HD, tải về máy và tự động ghi nhận vào Google Sheet.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://shopee.vn/*",
    "*://*.shopee.vn/*",
    "https://*.susercontent.com/*",
    "https://script.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee Image Curator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://shopee.vn/*",
        "*://*.shopee.vn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "save-shopee-image": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Lưu ảnh sản phẩm Shopee đang chọn"
    }
  }
}
